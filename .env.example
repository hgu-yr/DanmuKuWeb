# 复制为 .env 后按需修改

# 必填：首次启动创建管理员；之后以数据库中的账号为准
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# 对外访问地址（CORS / WebSocket Origin），生产改成真实域名
ALLOWED_ORIGINS=http://localhost

# 可选：留空则自动生成并保存到数据库；多实例部署时请显式配置相同值
JWT_SECRET=
CLIENT_TOKEN_SECRET=

# 对外端口
WEB_PORT=80

# ---------- 内容审核（可选） ----------
# 接入 OpenAI 兼容接口做语义判定；不配置则只用本地词库
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=20s

# 实时审核：本地词库未命中时同步调用模型，
# 分数 >= LLM_BLOCK_SCORE 的弹幕不进入公共弹幕池，只让发送者自己看见。
# 默认关闭，需要显式开启；开启后会占用发弹幕请求的延迟。
# LLM_REALTIME=false
# LLM_BLOCK_SCORE=80
# 单次实时判定超时（建议 1~2s，明显小于批量分析的 LLM_TIMEOUT）
# LLM_REALTIME_TIMEOUT=2s
# 同时在途的实时判定上限，超出时直接放行，保护发弹幕链路
# LLM_REALTIME_MAX_CONCURRENT=8
# 模型给出未知分类时自动创建分类并记录，便于下次复用
# LLM_AUTO_CREATE_RULE=true
# 自动创建的分类总数上限，达到后回退到 llm 兜底分类
# LLM_AUTO_CREATE_RULE_MAX=200
# 模型不可用时是否拒绝发送（默认放行，保证可用性）
# LLM_REALTIME_FAIL_CLOSED=false

# 异步在线学习：本地未命中的可疑内容交给模型复盘，结果进候选池
# LLM_ONLINE=true
# LLM_TRIGGER_SUSPICION=0.5
# LLM_AUTO_APPLY=0.8

# 可选：使用 CI 推送的 GHCR 镜像时覆盖
# SERVER_IMAGE=ghcr.io/hgu-yr/danmuku-server:latest
# WEB_IMAGE=ghcr.io/hgu-yr/danmuku-web:latest
