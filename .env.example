# 复制为 .env 后按需修改

# 首次启动创建管理员；之后以数据库中的账号为准。
# 生产环境建议显式设置强密码；留空会自动生成随机密码并打印到启动日志。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 对外访问地址（CORS / WebSocket Origin）。
# 生产环境必须改成真实域名，且不能为 *（否则服务会拒绝启动）。
ALLOWED_ORIGINS=http://localhost

# 反向代理网段（Docker Compose 默认使用 172.28.0.0/16）。
# 部署在 Nginx/Traefik 后面时必须配置，否则所有访客会被识别成同一个代理 IP，
# IP 限流会误伤全站。直接暴露后端二进制时留空即可。
TRUSTED_PROXIES=172.28.0.0/16

# 可选：留空则自动生成并保存到数据库；多实例部署时请显式配置相同值
JWT_SECRET=

# 对外端口
WEB_PORT=80

# WebSocket 握手限流（同一 IP 每分钟最多建连次数）
WS_HANDSHAKE_RATE_LIMIT=60

# LLM 在线学习结果是否允许自动写入线上规则。
# 默认 false：只会进入候选池，需后台人工采纳。开启前请确认已评估 prompt injection 风险。
LLM_AUTO_APPLY_ENABLED=false

# 可选：使用 CI 推送的 GHCR 镜像时覆盖
# SERVER_IMAGE=ghcr.io/hgu-yr/danmuku-server:latest
# WEB_IMAGE=ghcr.io/hgu-yr/danmuku-web:latest
